{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A037 Data Quality Output",
  "type": "object",
  "required": ["status", "quality_score", "issues", "remediation", "pass_fail", "confidence", "assumptions", "derived_from", "warnings", "errors", "next_action"],
  "properties": {
    "status": {"enum": ["success", "partial", "failed", "escalated"]},
    "quality_score": {"type": "number"},
    "issues": {"type": "array", "items": {"type": "object"}},
    "remediation": {"type": "array", "items": {"type": "object"}},
    "pass_fail": {"type": "string"},
    "confidence": {"enum": ["high", "medium", "low"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "derived_from": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array"},
    "errors": {"type": "array"},
    "next_action": {"type": "string"}
  },
  "additionalProperties": true
}
