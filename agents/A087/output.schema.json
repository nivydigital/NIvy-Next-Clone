{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A087 Social Media Strategist Output",
  "type": "object",
  "required": ["status", "channel_mix", "content_types", "engagement_plays", "success_metrics", "confidence", "assumptions", "derived_from", "warnings", "errors", "next_action"],
  "properties": {
    "status": {"enum": ["success", "partial", "failed", "escalated"]},
    "channel_mix": {"type": "array", "items": {"type": "object"}},
    "content_types": {"type": "array", "items": {"type": "object"}},
    "engagement_plays": {"type": "array", "items": {"type": "object"}},
    "success_metrics": {"type": "array", "items": {"type": "object"}},
    "confidence": {"enum": ["high", "medium", "low"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "derived_from": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array"},
    "errors": {"type": "array"},
    "next_action": {"type": "string"}
  },
  "additionalProperties": true
}
