{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A096 Executive Intelligence Analyst Output",
  "type": "object",
  "required": ["status", "summary", "key_decisions", "asks", "risks_opportunities", "confidence", "assumptions", "derived_from", "warnings", "errors", "next_action"],
  "properties": {
    "status": {"enum": ["success", "partial", "failed", "escalated"]},
    "summary": {"type": "string"},
    "key_decisions": {"type": "array", "items": {"type": "object"}},
    "asks": {"type": "array", "items": {"type": "object"}},
    "risks_opportunities": {"type": "array", "items": {"type": "object"}},
    "confidence": {"enum": ["high", "medium", "low"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "derived_from": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array"},
    "errors": {"type": "array"},
    "next_action": {"type": "string"}
  },
  "additionalProperties": true
}
