{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://agents/A109/output.schema.json",
  "title": "A109 Improvement Promotion Reviewer Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "evidence_assessment", "risks", "conditions", "recommendations", "status", "confidence", "assumptions", "derived_from", "warnings", "errors", "next_action"],
  "properties": {
    "status": {"type": "string", "enum": ["success", "partial", "failed", "escalated"]},
    "verdict": {"type": "string", "enum": ["promote", "hold", "reject"]},
    "evidence_assessment": {"type": "object"},
    "risks": {"type": "array", "items": {"type": "object"}},
    "conditions": {"type": "array", "items": {"type": "object"}},
    "recommendations": {"type": "array", "items": {"type": "object"}},
    "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "derived_from": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "string"}},
    "next_action": {"type": "string"}
  }
}
