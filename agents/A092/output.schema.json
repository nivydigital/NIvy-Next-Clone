{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A092 KPI Intelligence Analyst Output",
  "type": "object",
  "required": ["status", "variance_summary", "drivers", "recommended_actions", "confidence", "assumptions", "derived_from", "warnings", "errors", "next_action"],
  "properties": {
    "status": {"enum": ["success", "partial", "failed", "escalated"]},
    "variance_summary": {"type": "object"},
    "drivers": {"type": "array", "items": {"type": "object"}},
    "recommended_actions": {"type": "array", "items": {"type": "object"}},
    "confidence": {"enum": ["high", "medium", "low"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "derived_from": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array"},
    "errors": {"type": "array"},
    "next_action": {"type": "string"}
  },
  "additionalProperties": true
}
