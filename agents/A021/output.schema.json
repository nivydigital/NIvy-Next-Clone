{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A021 Support Strategy Output",
  "type": "object",
  "required": ["status", "support_model", "triage_rules", "sla_guidance", "escalation_paths", "knowledge_requirements", "confidence", "assumptions", "derived_from", "warnings", "errors", "next_action"],
  "properties": {
    "status": {"enum": ["success", "partial", "failed", "escalated"]},
    "support_model": {"type": "object"},
    "triage_rules": {"type": "array", "items": {"type": "object"}},
    "sla_guidance": {"type": "object"},
    "escalation_paths": {"type": "array", "items": {"type": "object"}},
    "knowledge_requirements": {"type": "array", "items": {"type": "object"}},
    "confidence": {"enum": ["high", "medium", "low"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "derived_from": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array"},
    "errors": {"type": "array"},
    "next_action": {"type": "string"}
  },
  "additionalProperties": true
}
