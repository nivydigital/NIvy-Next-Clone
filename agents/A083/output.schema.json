{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A083 Revenue Analytics Output",
  "type": "object",
  "required": ["status", "trend_summary", "cohort_insights", "drivers", "recommendations", "confidence", "assumptions", "derived_from", "warnings", "errors", "next_action"],
  "properties": {
    "status": {"enum": ["success", "partial", "failed", "escalated"]},
    "trend_summary": {"type": "object"},
    "cohort_insights": {"type": "array", "items": {"type": "object"}},
    "drivers": {"type": "array", "items": {"type": "object"}},
    "recommendations": {"type": "array", "items": {"type": "object"}},
    "confidence": {"enum": ["high", "medium", "low"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "derived_from": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array"},
    "errors": {"type": "array"},
    "next_action": {"type": "string"}
  },
  "additionalProperties": true
}
