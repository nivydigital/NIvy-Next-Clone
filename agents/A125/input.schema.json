    "dependency_map": {"type": "object"},
    "compliance_constraints": {"type": "array", "items": {"type": "string"}},
    "prior_dr_plan": {"type": "object"},
    "incident_history": {"type": "array", "items": {"type": "object"}},
    "tenant_id": {"type": "string"},
    "correlation_id": {"type": "string"}
  }
}
