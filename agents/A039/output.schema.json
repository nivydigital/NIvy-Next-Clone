{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A039 Lead Scoring Output",
  "type": "object",
  "required": ["status", "scores", "score_breakdown", "priority_order", "confidence", "assumptions", "derived_from", "warnings", "errors", "next_action"],
  "properties": {
    "status": {"enum": ["success", "partial", "failed", "escalated"]},
    "scores": {"type": "array", "items": {"type": "object"}},
    "score_breakdown": {"type": "array", "items": {"type": "object"}},
    "priority_order": {"type": "array", "items": {"type": "object"}},
    "confidence": {"enum": ["high", "medium", "low"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "derived_from": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array"},
    "errors": {"type": "array"},
    "next_action": {"type": "string"}
  },
  "additionalProperties": true
}
