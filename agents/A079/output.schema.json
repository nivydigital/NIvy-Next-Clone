{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A079 Accounts Receivable Analyst Output",
  "type": "object",
  "required": ["status", "priority_accounts", "aging_summary", "collection_actions", "confidence", "assumptions", "derived_from", "warnings", "errors", "next_action"],
  "properties": {
    "status": {"enum": ["success", "partial", "failed", "escalated"]},
    "priority_accounts": {"type": "array", "items": {"type": "object"}},
    "aging_summary": {"type": "object"},
    "collection_actions": {"type": "array", "items": {"type": "object"}},
    "confidence": {"enum": ["high", "medium", "low"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "derived_from": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array"},
    "errors": {"type": "array"},
    "next_action": {"type": "string"}
  },
  "additionalProperties": true
}
