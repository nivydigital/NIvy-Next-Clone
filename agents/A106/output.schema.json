{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://agents/A106/output.schema.json",
  "title": "A106 Skill Improvement Agent Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposed_skill_changes", "gap_analysis", "rationale", "risks", "validation_plan", "status", "confidence", "assumptions", "derived_from", "warnings", "errors", "next_action"],
  "properties": {
    "status": {"type": "string", "enum": ["success", "partial", "failed", "escalated"]},
    "proposed_skill_changes": {"type": "array", "items": {"type": "object"}},
    "gap_analysis": {"type": "array", "items": {"type": "object"}},
    "rationale": {"type": "object"},
    "risks": {"type": "array", "items": {"type": "object"}},
    "validation_plan": {"type": "object"},
    "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "derived_from": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "string"}},
    "next_action": {"type": "string"}
  }
}
