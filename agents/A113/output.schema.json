{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://agents/A113/output.schema.json",
  "title": "A113 Collaboration Policy Agent Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_set", "escalation_paths", "approval_gates", "exceptions", "recommendations", "status", "confidence", "assumptions", "derived_from", "warnings", "errors", "next_action"],
  "properties": {
    "status": {"type": "string", "enum": ["success", "partial", "failed", "escalated"]},
    "policy_set": {"type": "array", "items": {"type": "object"}},
    "escalation_paths": {"type": "array", "items": {"type": "object"}},
    "approval_gates": {"type": "array", "items": {"type": "object"}},
    "exceptions": {"type": "array", "items": {"type": "object"}},
    "recommendations": {"type": "array", "items": {"type": "object"}},
    "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "derived_from": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "string"}},
    "next_action": {"type": "string"}
  }
}
