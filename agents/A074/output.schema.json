{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A074 Support Triage Output",
  "type": "object",
  "required": ["status", "severity", "category", "route_to", "playbook", "confidence", "assumptions", "derived_from", "warnings", "errors", "next_action"],
  "properties": {
    "status": {"enum": ["success", "partial", "failed", "escalated"]},
    "severity": {"type": "string"},
    "category": {"type": "string"},
    "route_to": {"type": "string"},
    "playbook": {"type": "object"},
    "confidence": {"enum": ["high", "medium", "low"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "derived_from": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array"},
    "errors": {"type": "array"},
    "next_action": {"type": "string"}
  },
  "additionalProperties": true
}
