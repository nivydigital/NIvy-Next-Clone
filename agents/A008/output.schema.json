{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A008 Offer & Pricing Strategy Output",
  "type": "object",
  "required": ["status", "offers", "packaging", "pricing_guidance", "differentiation", "objections", "confidence", "assumptions", "derived_from", "warnings", "errors", "next_action"],
  "properties": {
    "status": {"enum": ["success", "partial", "failed", "escalated"]},
    "offers": {"type": "array", "items": {"type": "object"}},
    "packaging": {"type": "array", "items": {"type": "object"}},
    "pricing_guidance": {"type": "object"},
    "differentiation": {"type": "array", "items": {"type": "string"}},
    "objections": {"type": "array", "items": {"type": "object"}},
    "confidence": {"enum": ["high", "medium", "low"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "derived_from": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array"},
    "errors": {"type": "array"},
    "next_action": {"type": "string"}
  },
  "additionalProperties": true
}
