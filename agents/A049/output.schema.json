{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A049 Personalization Output",
  "type": "object",
  "required": ["status", "hooks", "context_snippets", "do_not_use", "confidence", "assumptions", "derived_from", "warnings", "errors", "next_action"],
  "properties": {
    "status": {"enum": ["success", "partial", "failed", "escalated"]},
    "hooks": {"type": "array", "items": {"type": "object"}},
    "context_snippets": {"type": "array", "items": {"type": "object"}},
    "do_not_use": {"type": "array", "items": {"type": "string"}},
    "confidence": {"enum": ["high", "medium", "low"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "derived_from": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array"},
    "errors": {"type": "array"},
    "next_action": {"type": "string"}
  },
  "additionalProperties": true
}
