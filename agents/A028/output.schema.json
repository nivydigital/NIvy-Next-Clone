{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A028 Continuous Improvement Strategy Output",
  "type": "object",
  "required": ["status", "learning_loops", "experiment_to_scale", "retrospective_cadence", "improvement_ownership", "prioritization_rules", "confidence", "assumptions", "derived_from", "warnings", "errors", "next_action"],
  "properties": {
    "status": {"enum": ["success", "partial", "failed", "escalated"]},
    "learning_loops": {"type": "array", "items": {"type": "object"}},
    "experiment_to_scale": {"type": "object"},
    "retrospective_cadence": {"type": "object"},
    "improvement_ownership": {"type": "array", "items": {"type": "object"}},
    "prioritization_rules": {"type": "array", "items": {"type": "object"}},
    "confidence": {"enum": ["high", "medium", "low"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "derived_from": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array"},
    "errors": {"type": "array"},
    "next_action": {"type": "string"}
  },
  "additionalProperties": true
}
