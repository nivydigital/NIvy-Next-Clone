  "properties": {
    "status": {"enum": ["success", "partial", "failed", "escalated"]},
    "report_hierarchy": {"type": "array", "items": {"type": "object"}},
    "kpi_definitions": {"type": "array", "items": {"type": "object"}},
    "data_ownership": {"type": "array", "items": {"type": "object"}},
    "decision_cadence": {"type": "object"},
    "dashboard_outline": {"type": "array", "items": {"type": "object"}},
    "confidence": {"enum": ["high", "medium", "low"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "derived_from": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array"},
    "errors": {"type": "array"},
    "next_action": {"type": "string"}
  },
  "additionalProperties": true
}
