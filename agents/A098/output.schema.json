{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A098 Evaluation Analyst Output",
  "type": "object",
  "required": ["status", "scores", "findings", "pass_fail", "recommendations", "confidence", "assumptions", "derived_from", "warnings", "errors", "next_action"],
  "properties": {
    "status": {"enum": ["success", "partial", "failed", "escalated"]},
    "scores": {"type": "object"},
    "findings": {"type": "array", "items": {"type": "object"}},
    "pass_fail": {"type": "string"},
    "recommendations": {"type": "array", "items": {"type": "object"}},
    "confidence": {"enum": ["high", "medium", "low"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "derived_from": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array"},
    "errors": {"type": "array"},
    "next_action": {"type": "string"}
  },
  "additionalProperties": true
}
