{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://agents/A098/output.schema.json",
  "title": "A098 Evaluation Analyst Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["score_summary", "dimension_scores", "failures", "gaps", "recommendations", "status", "confidence", "assumptions", "derived_from", "warnings", "errors", "next_action"],
  "properties": {
    "status": {"type": "string", "enum": ["success", "partial", "failed", "escalated"]},
    "score_summary": {"type": "object"},
    "dimension_scores": {"type": "array", "items": {"type": "object"}},
    "failures": {"type": "array", "items": {"type": "object"}},
    "gaps": {"type": "array", "items": {"type": "object"}},
    "recommendations": {"type": "array", "items": {"type": "object"}},
    "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "derived_from": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "string"}},
    "next_action": {"type": "string"}
  }
}
