{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A084 Marketing Strategist Output",
  "type": "object",
  "required": ["status", "pillars", "channel_priorities", "messaging_themes", "success_metrics", "confidence", "assumptions", "derived_from", "warnings", "errors", "next_action"],
  "properties": {
    "status": {"enum": ["success", "partial", "failed", "escalated"]},
    "pillars": {"type": "array", "items": {"type": "object"}},
    "channel_priorities": {"type": "array", "items": {"type": "object"}},
    "messaging_themes": {"type": "array", "items": {"type": "object"}},
    "success_metrics": {"type": "array", "items": {"type": "object"}},
    "confidence": {"enum": ["high", "medium", "low"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "derived_from": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array"},
    "errors": {"type": "array"},
    "next_action": {"type": "string"}
  },
  "additionalProperties": true
}
