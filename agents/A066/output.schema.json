{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A066 Inbound Communication Triage Output",
  "type": "object",
  "required": ["status", "intent", "urgency", "route_to", "summary", "confidence", "assumptions", "derived_from", "warnings", "errors", "next_action"],
  "properties": {
    "status": {"enum": ["success", "partial", "failed", "escalated"]},
    "intent": {"type": "string"},
    "urgency": {"type": "string"},
    "route_to": {"type": "string"},
    "summary": {"type": "string"},
    "confidence": {"enum": ["high", "medium", "low"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "derived_from": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array"},
    "errors": {"type": "array"},
    "next_action": {"type": "string"}
  },
  "additionalProperties": true
}
