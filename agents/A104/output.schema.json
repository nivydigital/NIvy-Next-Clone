{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://agents/A104/output.schema.json",
  "title": "A104 Feedback Analyst Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["theme_summary", "severity_distribution", "actionable_signals", "risks", "recommendations", "status", "confidence", "assumptions", "derived_from", "warnings", "errors", "next_action"],
  "properties": {
    "status": {"type": "string", "enum": ["success", "partial", "failed", "escalated"]},
    "theme_summary": {"type": "object"},
    "severity_distribution": {"type": "object"},
    "actionable_signals": {"type": "array", "items": {"type": "object"}},
    "risks": {"type": "array", "items": {"type": "object"}},
    "recommendations": {"type": "array", "items": {"type": "object"}},
    "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "derived_from": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "string"}},
    "next_action": {"type": "string"}
  }
}
