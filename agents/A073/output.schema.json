{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A073 Customer Health Analyst Output",
  "type": "object",
  "required": ["status", "health_score", "risk_flags", "expansion_signals", "recommended_actions", "confidence", "assumptions", "derived_from", "warnings", "errors", "next_action"],
  "properties": {
    "status": {"enum": ["success", "partial", "failed", "escalated"]},
    "health_score": {"type": "number"},
    "risk_flags": {"type": "array", "items": {"type": "object"}},
    "expansion_signals": {"type": "array", "items": {"type": "object"}},
    "recommended_actions": {"type": "array", "items": {"type": "object"}},
    "confidence": {"enum": ["high", "medium", "low"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "derived_from": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array"},
    "errors": {"type": "array"},
    "next_action": {"type": "string"}
  },
  "additionalProperties": true
}
