{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A067 Conversation Intelligence Output",
  "type": "object",
  "required": ["status", "summary", "objections", "commitments", "sentiment", "next_best_actions", "confidence", "assumptions", "derived_from", "warnings", "errors", "next_action"],
  "properties": {
    "status": {"enum": ["success", "partial", "failed", "escalated"]},
    "summary": {"type": "string"},
    "objections": {"type": "array", "items": {"type": "object"}},
    "commitments": {"type": "array", "items": {"type": "object"}},
    "sentiment": {"type": "string"},
    "next_best_actions": {"type": "array", "items": {"type": "object"}},
    "confidence": {"enum": ["high", "medium", "low"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "derived_from": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array"},
    "errors": {"type": "array"},
    "next_action": {"type": "string"}
  },
  "additionalProperties": true
}
