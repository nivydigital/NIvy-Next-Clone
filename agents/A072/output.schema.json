{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A072 Customer Onboarding Planner Output",
  "type": "object",
  "required": ["status", "tasks", "timeline", "owners", "checkpoints", "confidence", "assumptions", "derived_from", "warnings", "errors", "next_action"],
  "properties": {
    "status": {"enum": ["success", "partial", "failed", "escalated"]},
    "tasks": {"type": "array", "items": {"type": "object"}},
    "timeline": {"type": "object"},
    "owners": {"type": "array", "items": {"type": "object"}},
    "checkpoints": {"type": "array", "items": {"type": "object"}},
    "confidence": {"enum": ["high", "medium", "low"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "derived_from": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array"},
    "errors": {"type": "array"},
    "next_action": {"type": "string"}
  },
  "additionalProperties": true
}
