{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A085 Content Strategist Output",
  "type": "object",
  "required": ["status", "pillars", "formats", "calendar_outline", "success_metrics", "confidence", "assumptions", "derived_from", "warnings", "errors", "next_action"],
  "properties": {
    "status": {"enum": ["success", "partial", "failed", "escalated"]},
    "pillars": {"type": "array", "items": {"type": "object"}},
    "formats": {"type": "array", "items": {"type": "object"}},
    "calendar_outline": {"type": "array", "items": {"type": "object"}},
    "success_metrics": {"type": "array", "items": {"type": "object"}},
    "confidence": {"enum": ["high", "medium", "low"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "derived_from": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array"},
    "errors": {"type": "array"},
    "next_action": {"type": "string"}
  },
  "additionalProperties": true
}
