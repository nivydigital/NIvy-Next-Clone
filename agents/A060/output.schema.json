{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A060 Proposal Agent Output",
  "type": "object",
  "required": ["status", "sections", "value_summary", "pricing_block", "next_steps", "confidence", "assumptions", "derived_from", "warnings", "errors", "next_action"],
  "properties": {
    "status": {"enum": ["success", "partial", "failed", "escalated"]},
    "sections": {"type": "array", "items": {"type": "object"}},
    "value_summary": {"type": "string"},
    "pricing_block": {"type": "object"},
    "next_steps": {"type": "array", "items": {"type": "object"}},
    "confidence": {"enum": ["high", "medium", "low"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "derived_from": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array"},
    "errors": {"type": "array"},
    "next_action": {"type": "string"}
  },
  "additionalProperties": true
}
