{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A036 Lead Enrichment Output",
  "type": "object",
  "required": ["status", "enriched_records", "fields_added", "sources", "confidence", "assumptions", "derived_from", "warnings", "errors", "next_action"],
  "properties": {
    "status": {"enum": ["success", "partial", "failed", "escalated"]},
    "enriched_records": {"type": "array", "items": {"type": "object"}},
    "fields_added": {"type": "array", "items": {"type": "string"}},
    "sources": {"type": "array", "items": {"type": "object"}},
    "confidence": {"enum": ["high", "medium", "low"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "derived_from": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array"},
    "errors": {"type": "array"},
    "next_action": {"type": "string"}
  },
  "additionalProperties": true
}
