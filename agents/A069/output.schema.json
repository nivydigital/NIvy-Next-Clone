{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A069 Meeting Intelligence Output",
  "type": "object",
  "required": ["status", "decisions", "action_items", "risks", "follow_ups", "summary", "confidence", "assumptions", "derived_from", "warnings", "errors", "next_action"],
  "properties": {
    "status": {"enum": ["success", "partial", "failed", "escalated"]},
    "decisions": {"type": "array", "items": {"type": "object"}},
    "action_items": {"type": "array", "items": {"type": "object"}},
    "risks": {"type": "array", "items": {"type": "object"}},
    "follow_ups": {"type": "array", "items": {"type": "object"}},
    "summary": {"type": "string"},
    "confidence": {"enum": ["high", "medium", "low"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "derived_from": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array"},
    "errors": {"type": "array"},
    "next_action": {"type": "string"}
  },
  "additionalProperties": true
}
