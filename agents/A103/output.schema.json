{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://agents/A103/output.schema.json",
  "title": "A103 Evidence Collector Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_pack", "coverage", "gaps", "integrity_notes", "recommendations", "status", "confidence", "assumptions", "derived_from", "warnings", "errors", "next_action"],
  "properties": {
    "status": {"type": "string", "enum": ["success", "partial", "failed", "escalated"]},
    "evidence_pack": {"type": "object"},
    "coverage": {"type": "object"},
    "gaps": {"type": "array", "items": {"type": "object"}},
    "integrity_notes": {"type": "array", "items": {"type": "object"}},
    "recommendations": {"type": "array", "items": {"type": "object"}},
    "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "derived_from": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "string"}},
    "next_action": {"type": "string"}
  }
}
