{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A093 Planning Analyst Output",
  "type": "object",
  "required": ["status", "priorities", "workstreams", "owners", "checkpoints", "confidence", "assumptions", "derived_from", "warnings", "errors", "next_action"],
  "properties": {
    "status": {"enum": ["success", "partial", "failed", "escalated"]},
    "priorities": {"type": "array", "items": {"type": "object"}},
    "workstreams": {"type": "array", "items": {"type": "object"}},
    "owners": {"type": "array", "items": {"type": "object"}},
    "checkpoints": {"type": "array", "items": {"type": "object"}},
    "confidence": {"enum": ["high", "medium", "low"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "derived_from": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array"},
    "errors": {"type": "array"},
    "next_action": {"type": "string"}
  },
  "additionalProperties": true
}
