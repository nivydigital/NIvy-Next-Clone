{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://agents/A114/output.schema.json",
  "title": "A114 Collaboration Failure Handler Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["failure_diagnosis", "impact_assessment", "recovery_options", "recommended_sequence", "escalation", "status", "confidence", "assumptions", "derived_from", "warnings", "errors", "next_action"],
  "properties": {
    "status": {"type": "string", "enum": ["success", "partial", "failed", "escalated"]},
    "failure_diagnosis": {"type": "object"},
    "impact_assessment": {"type": "object"},
    "recovery_options": {"type": "array", "items": {"type": "object"}},
    "recommended_sequence": {"type": "array", "items": {"type": "object"}},
    "escalation": {"type": "object"},
    "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "derived_from": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "string"}},
    "next_action": {"type": "string"}
  }
}
