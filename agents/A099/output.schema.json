{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A099 Regression QA Agent Output",
  "type": "object",
  "required": ["status", "regressions", "severity", "pass_fail", "recommended_fixes", "confidence", "assumptions", "derived_from", "warnings", "errors", "next_action"],
  "properties": {
    "status": {"enum": ["success", "partial", "failed", "escalated"]},
    "regressions": {"type": "array", "items": {"type": "object"}},
    "severity": {"type": "string"},
    "pass_fail": {"type": "string"},
    "recommended_fixes": {"type": "array", "items": {"type": "object"}},
    "confidence": {"enum": ["high", "medium", "low"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "derived_from": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array"},
    "errors": {"type": "array"},
    "next_action": {"type": "string"}
  },
  "additionalProperties": true
}
