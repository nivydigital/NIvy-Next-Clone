{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://agents/A118/output.schema.json",
  "title": "A118 Agent Certification Agent Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "gate_results", "evidence_gaps", "remediation", "status", "confidence", "assumptions", "derived_from", "warnings", "errors", "next_action"],
  "properties": {
    "status": {"type": "string", "enum": ["success", "partial", "failed", "escalated"]},
    "verdict": {"type": "string", "enum": ["pass", "conditional", "fail"]},
    "gate_results": {"type": "array", "items": {"type": "object"}},
    "evidence_gaps": {"type": "array", "items": {"type": "object"}},
    "remediation": {"type": "array", "items": {"type": "object"}},
    "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "derived_from": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "string"}},
    "next_action": {"type": "string"}
  }
}
