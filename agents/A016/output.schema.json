{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A016 Pipeline & Deal Strategy Output",
  "type": "object",
  "required": ["status", "stages", "progression_rules", "deal_qualification", "forecast_guidance", "exit_criteria", "confidence", "assumptions", "derived_from", "warnings", "errors", "next_action"],
  "properties": {
    "status": {"enum": ["success", "partial", "failed", "escalated"]},
    "stages": {"type": "array", "items": {"type": "object"}},
    "progression_rules": {"type": "array", "items": {"type": "object"}},
    "deal_qualification": {"type": "object"},
    "forecast_guidance": {"type": "object"},
    "exit_criteria": {"type": "array", "items": {"type": "object"}},
    "confidence": {"enum": ["high", "medium", "low"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "derived_from": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array"},
    "errors": {"type": "array"},
    "next_action": {"type": "string"}
  },
  "additionalProperties": true
}
