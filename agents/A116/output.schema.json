{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://agents/A116/output.schema.json",
  "title": "A116 Agent Package Builder Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["package_manifest", "dependency_lock", "skill_bindings", "install_readiness", "gaps", "status", "confidence", "assumptions", "derived_from", "warnings", "errors", "next_action"],
  "properties": {
    "status": {"type": "string", "enum": ["success", "partial", "failed", "escalated"]},
    "package_manifest": {"type": "object"},
    "dependency_lock": {"type": "object"},
    "skill_bindings": {"type": "array", "items": {"type": "object"}},
    "install_readiness": {"type": "object"},
    "gaps": {"type": "array", "items": {"type": "object"}},
    "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "derived_from": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "string"}},
    "next_action": {"type": "string"}
  }
}
