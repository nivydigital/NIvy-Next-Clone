{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A077 Feedback & NPS Analyst Output",
  "type": "object",
  "required": ["status", "themes", "nps_summary", "promoter_actions", "detractor_actions", "confidence", "assumptions", "derived_from", "warnings", "errors", "next_action"],
  "properties": {
    "status": {"enum": ["success", "partial", "failed", "escalated"]},
    "themes": {"type": "array", "items": {"type": "object"}},
    "nps_summary": {"type": "object"},
    "promoter_actions": {"type": "array", "items": {"type": "object"}},
    "detractor_actions": {"type": "array", "items": {"type": "object"}},
    "confidence": {"enum": ["high", "medium", "low"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "derived_from": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array"},
    "errors": {"type": "array"},
    "next_action": {"type": "string"}
  },
  "additionalProperties": true
}
