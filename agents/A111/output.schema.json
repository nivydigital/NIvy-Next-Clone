{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://agents/A111/output.schema.json",
  "title": "A111 Agent Handoff Manager Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["handoff_package", "acceptance_checklist", "residual_risks", "audit_notes", "recommendations", "status", "confidence", "assumptions", "derived_from", "warnings", "errors", "next_action"],
  "properties": {
    "status": {"type": "string", "enum": ["success", "partial", "failed", "escalated"]},
    "handoff_package": {"type": "object"},
    "acceptance_checklist": {"type": "array", "items": {"type": "object"}},
    "residual_risks": {"type": "array", "items": {"type": "object"}},
    "audit_notes": {"type": "array", "items": {"type": "object"}},
    "recommendations": {"type": "array", "items": {"type": "object"}},
    "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "derived_from": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "string"}},
    "next_action": {"type": "string"}
  }
}
