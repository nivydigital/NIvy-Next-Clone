{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A055 Meeting Prep Output",
  "type": "object",
  "required": ["status", "agenda", "talking_points", "risks", "questions", "confidence", "assumptions", "derived_from", "warnings", "errors", "next_action"],
  "properties": {
    "status": {"enum": ["success", "partial", "failed", "escalated"]},
    "agenda": {"type": "array", "items": {"type": "object"}},
    "talking_points": {"type": "array", "items": {"type": "object"}},
    "risks": {"type": "array", "items": {"type": "object"}},
    "questions": {"type": "array", "items": {"type": "object"}},
    "confidence": {"enum": ["high", "medium", "low"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "derived_from": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array"},
    "errors": {"type": "array"},
    "next_action": {"type": "string"}
  },
  "additionalProperties": true
}
