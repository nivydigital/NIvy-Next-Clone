{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A089 Marketing Analytics Output",
  "type": "object",
  "required": ["status", "channel_summary", "top_insights", "recommended_experiments", "confidence", "assumptions", "derived_from", "warnings", "errors", "next_action"],
  "properties": {
    "status": {"enum": ["success", "partial", "failed", "escalated"]},
    "channel_summary": {"type": "array", "items": {"type": "object"}},
    "top_insights": {"type": "array", "items": {"type": "object"}},
    "recommended_experiments": {"type": "array", "items": {"type": "object"}},
    "confidence": {"enum": ["high", "medium", "low"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "derived_from": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array"},
    "errors": {"type": "array"},
    "next_action": {"type": "string"}
  },
  "additionalProperties": true
}
