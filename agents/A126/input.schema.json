{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://agents/A126/input.schema.json",
  "title": "A126 Deployment Rollout Agent Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["release_manifest", "environment_target"],
  "properties": {
    "release_manifest": {"type": "object"},
    "environment_target": {"type": "string", "minLength": 1},
    "current_version_map": {"type": "object"},
    "health_baselines": {"type": "object"},
    "change_window": {"type": "object"},
    "rollback_policy": {"type": "object"},
    "stakeholder_list": {"type": "array", "items": {"type": "string"}},
    "prior_rollout_report": {"type": "object"},
    "tenant_id": {"type": "string"},
    "correlation_id": {"type": "string"}
  }
}
