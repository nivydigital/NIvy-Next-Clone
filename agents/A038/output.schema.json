{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A038 Verification Output",
  "type": "object",
  "required": ["status", "verified_records", "failed_checks", "evidence", "confidence", "assumptions", "derived_from", "warnings", "errors", "next_action"],
  "properties": {
    "status": {"enum": ["success", "partial", "failed", "escalated"]},
    "verified_records": {"type": "array", "items": {"type": "object"}},
    "failed_checks": {"type": "array", "items": {"type": "object"}},
    "evidence": {"type": "array", "items": {"type": "object"}},
    "confidence": {"enum": ["high", "medium", "low"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "derived_from": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array"},
    "errors": {"type": "array"},
    "next_action": {"type": "string"}
  },
  "additionalProperties": true
}
