{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://agents/A107/output.schema.json",
  "title": "A107 Experiment Manager Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["experiment_design", "metrics", "stop_rules", "risks", "recommendations", "status", "confidence", "assumptions", "derived_from", "warnings", "errors", "next_action"],
  "properties": {
    "status": {"type": "string", "enum": ["success", "partial", "failed", "escalated"]},
    "experiment_design": {"type": "object"},
    "metrics": {"type": "array", "items": {"type": "object"}},
    "stop_rules": {"type": "array", "items": {"type": "object"}},
    "risks": {"type": "array", "items": {"type": "object"}},
    "recommendations": {"type": "array", "items": {"type": "object"}},
    "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "derived_from": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "string"}},
    "next_action": {"type": "string"}
  }
}
