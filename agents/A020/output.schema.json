{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A020 Customer Health Strategy Output",
  "type": "object",
  "required": ["status", "health_dimensions", "leading_indicators", "scoring_rules", "intervention_triggers", "reporting_cadence", "confidence", "assumptions", "derived_from", "warnings", "errors", "next_action"],
  "properties": {
    "status": {"enum": ["success", "partial", "failed", "escalated"]},
    "health_dimensions": {"type": "array", "items": {"type": "object"}},
    "leading_indicators": {"type": "array", "items": {"type": "object"}},
    "scoring_rules": {"type": "object"},
    "intervention_triggers": {"type": "array", "items": {"type": "object"}},
    "reporting_cadence": {"type": "object"},
    "confidence": {"enum": ["high", "medium", "low"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "derived_from": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array"},
    "errors": {"type": "array"},
    "next_action": {"type": "string"}
  },
  "additionalProperties": true
}
