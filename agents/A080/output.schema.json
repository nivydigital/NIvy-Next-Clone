{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A080 Accounts Payable Analyst Output",
  "type": "object",
  "required": ["status", "due_summary", "payment_priorities", "risk_flags", "confidence", "assumptions", "derived_from", "warnings", "errors", "next_action"],
  "properties": {
    "status": {"enum": ["success", "partial", "failed", "escalated"]},
    "due_summary": {"type": "object"},
    "payment_priorities": {"type": "array", "items": {"type": "object"}},
    "risk_flags": {"type": "array", "items": {"type": "object"}},
    "confidence": {"enum": ["high", "medium", "low"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "derived_from": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array"},
    "errors": {"type": "array"},
    "next_action": {"type": "string"}
  },
  "additionalProperties": true
}
