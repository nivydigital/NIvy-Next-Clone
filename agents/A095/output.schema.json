{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A095 Risk Analyst Output",
  "type": "object",
  "required": ["status", "risks", "severity", "mitigations", "residual_risk", "confidence", "assumptions", "derived_from", "warnings", "errors", "next_action"],
  "properties": {
    "status": {"enum": ["success", "partial", "failed", "escalated"]},
    "risks": {"type": "array", "items": {"type": "object"}},
    "severity": {"type": "string"},
    "mitigations": {"type": "array", "items": {"type": "object"}},
    "residual_risk": {"type": "string"},
    "confidence": {"enum": ["high", "medium", "low"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "derived_from": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array"},
    "errors": {"type": "array"},
    "next_action": {"type": "string"}
  },
  "additionalProperties": true
}
