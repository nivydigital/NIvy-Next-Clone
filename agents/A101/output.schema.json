{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://agents/A101/output.schema.json",
  "title": "A101 Runtime Quality Monitor Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["quality_status", "signal_summary", "anomalies", "escalations", "recommendations", "status", "confidence", "assumptions", "derived_from", "warnings", "errors", "next_action"],
  "properties": {
    "status": {"type": "string", "enum": ["success", "partial", "failed", "escalated"]},
    "quality_status": {"type": "object"},
    "signal_summary": {"type": "object"},
    "anomalies": {"type": "array", "items": {"type": "object"}},
    "escalations": {"type": "array", "items": {"type": "object"}},
    "recommendations": {"type": "array", "items": {"type": "object"}},
    "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "derived_from": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "string"}},
    "next_action": {"type": "string"}
  }
}
