{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A015 Qualification & Scoring Strategy Output",
  "type": "object",
  "required": ["status", "qualification_criteria", "scoring_model", "routing_rules", "disqualification_rules", "handoff_triggers", "confidence", "assumptions", "derived_from", "warnings", "errors", "next_action"],
  "properties": {
    "status": {"enum": ["success", "partial", "failed", "escalated"]},
    "qualification_criteria": {"type": "array", "items": {"type": "object"}},
    "scoring_model": {"type": "object"},
    "routing_rules": {"type": "array", "items": {"type": "object"}},
    "disqualification_rules": {"type": "array", "items": {"type": "object"}},
    "handoff_triggers": {"type": "array", "items": {"type": "object"}},
    "confidence": {"enum": ["high", "medium", "low"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "derived_from": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array"},
    "errors": {"type": "array"},
    "next_action": {"type": "string"}
  },
  "additionalProperties": true
}
