{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A088 Paid Media Analyst Output",
  "type": "object",
  "required": ["status", "performance_summary", "budget_recommendations", "creative_recommendations", "confidence", "assumptions", "derived_from", "warnings", "errors", "next_action"],
  "properties": {
    "status": {"enum": ["success", "partial", "failed", "escalated"]},
    "performance_summary": {"type": "object"},
    "budget_recommendations": {"type": "array", "items": {"type": "object"}},
    "creative_recommendations": {"type": "array", "items": {"type": "object"}},
    "confidence": {"enum": ["high", "medium", "low"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "derived_from": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array"},
    "errors": {"type": "array"},
    "next_action": {"type": "string"}
  },
  "additionalProperties": true
}
