# Nivy AIOS — environment template (Phase 10)
# Copy to .env and fill values. NEVER commit .env.

NIVY_API_PORT=8000
NIVY_WEB_PORT=3000

POSTGRES_DB=nivy
POSTGRES_USER=nivy
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://nivy:REPLACE_ME@postgres:5432/nivy

REDIS_URL=redis://redis:6379
QDRANT_URL=http://qdrant:6333
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=120

N8N_URL=http://n8n:5678
N8N_EMAIL_WEBHOOK=/webhook/nivy/send-email
EMAIL_MOCK=1
FORCE_LIVE_EMAIL=0

FIRECRAWL_URL=https://api.firecrawl.dev/v2
FIRECRAWL_API_KEY=
BROWSER_USE_URL=https://api.browser-use.com/api/v3
BROWSER_USE_API_KEY=
REACHER_BASE_URL=
ODOO_URL=
ODOO_DB=
ODOO_USER=
ODOO_PASSWORD=

KNOWLEDGE_MOCK=1
TOOLS_MOCK_ALL=1
LEAD_OUTREACH_DRY_RUN=1
ALLOW_LIVE_WEB_FETCH=
ALLOW_LIVE_WEB_CRAWL=

NIVY_POSTGRES_DATA=./.local-data/postgres
NIVY_BACKUP_DIR=./.local-data/backups
